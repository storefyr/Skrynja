[Desktop Entry]
Type=Application
X-Nemo-Application-Type=silica-qt5
Name=Skrynja
Icon=harbour-skrynja
Exec=harbour-skrynja
Comment=Chat med Mistral AI med websøgning
Categories=Network;Chat;

# Eksplicit fravalg: sandboxing er default-on (/etc/sailjail/config/
# 50-enable-sandboxing.conf, Enabled=true), og fravær af sektion betyder
# IKKE fravær af jail — målt 2026-11-02 (målejournal runde 7). Kun
# Sandboxing=Disabled (læses af /usr/bin/sailjaild) kører appen u-jail'ed,
# så grid-start kan spawne agenten i ~/.local/bin. Implementerer punkt 122
# [B] storefyr 2026-10-31 (spec v3 §9.2e: appen køres ikke indespærret).
[X-Sailjail]
Sandboxing=Disabled
